# ═══════════════════════════════════════════════════════════════════════
#  HexNinja — environment variables
#  Only variables the code actually reads are listed. Copy to .env and fill in. Never commit .env.
#  Do NOT wrap values in quotes (proxy.ts reads SESSION_SECRET raw).
#  On Vercel: Project → Settings → Environment Variables (same names).
# ═══════════════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────── REQUIRED ──
# Dashboard → Project Settings → API / API Keys
# Storage bucket required: "docx-templates" (private)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Secret / service_role key — full DB access, server-side only.
SUPABASE_SERVICE_KEY=

# ── Auth ─────────────────────────────────────────────────── REQUIRED ──
# HMAC key that signs login cookies + Chrome-extension Bearer tokens.
# Changing it logs out every user and extension session.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value in production.
SESSION_SECRET=

# ── Google Drive ─────────────────────── REQUIRED for resume generation ──
# Google Cloud Console → APIs & Services:
#   1. Enable "Google Drive API"
#   2. Credentials → OAuth client ID → Web application
#      Authorized redirect URI: http://localhost:3333/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Run once, sign in as the Drive account that should own the files:
#   GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=... node scripts/get-refresh-token.mjs
# NOTE: if the OAuth app is "External" in "Testing" mode, this token
# expires after 7 days — use an Internal (Workspace) app or publish it.
GOOGLE_REFRESH_TOKEN=

# ── Google Drive (optional) ──────────────────────────────────────────────
# Folder id from https://drive.google.com/drive/folders/<THIS_PART>
# Blank = upload to the Drive root of the authorized account.
GOOGLE_DRIVE_FOLDER_ID=
